---
// /projects is the main page; the root URL just forwards there immediately.
import { withBase } from "@utils/withBase";

const target = withBase("/projects");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Janelia Open Source Hardware</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <a href={target}>Continue to the projects page</a>
  </body>
</html>
