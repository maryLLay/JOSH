---
import "@styles/tailwind.css";
import { siteConfig } from "../../siteConfig";
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";
import CardContainer from "@components/projects/CardContainer";
import CardContent from "@components/projects/CardContent.astro";
import CardImage from "@components/projects/CardImage";
import FilterMenu from "@components/projects/FilterMenu";
import ProjectCount from "@components/projects/ProjectCount";
import SearchInput from "@components/projects/SearchInput";
import SortMenu from "@components/projects/SortMenu";
import Tag from "@components/projects/Tag.astro";
import ViewToggle from "@components/ViewToggle.astro";
import ToggleFilterMenuBtn from "@components/projects/ToggleFilterMenuBtn";

import { withBase } from "@utils/withBase";
import { getTagKeysAndValues } from "@utils/getTags";

const pageTitle = "Projects";
const allProjects = await getCollection("projects");

// uniqueTags is an object where keys = unique tag categories, values = unique tags within a category, both across allProjects. All lowercase.
// used to populate the filter menu
const uniqueTags = getTagKeysAndValues(allProjects);

// Project ids in each sort order. CardContainer uses a project's position in
// the selected list as its CSS "order" within the card grid.
const idsAlphabetical = [...allProjects]
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((project) => project.id);

// update_date is filled in automatically (see .github/actions/update-project-dates.js).
// Projects with no known update_date go last, whichever direction is chosen.
const undatedIds = allProjects
  .filter((project) => !project.data.update_date)
  .map((project) => project.id);
const idsByUpdateDateAsc = allProjects
  .filter((project) => project.data.update_date)
  .sort((a, b) => a.data.update_date - b.data.update_date)
  .map((project) => project.id);

const sortedIdsMap = {
  alphabetical: idsAlphabetical,
  "updated-newest": [...idsByUpdateDateAsc].reverse().concat(undatedIds),
  "updated-oldest": [...idsByUpdateDateAsc, ...undatedIds],
};
---

<BaseLayout pageTitle={pageTitle}>
  <header class="px-6 lg:px-20 xl:px-32 pt-28 lg:pt-32">
    <h1
      class="text-4xl sm:text-5xl font-bold leading-tighter tracking-tighter font-heading"
    >
      {siteConfig.name}
    </h1>
    <p class="mt-3 max-w-3xl text-xl text-muted dark:text-slate-400">
      {siteConfig.tagline}. Find designs to build, see which file types and
      tools they need, and cite them.
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
      <ViewToggle current="cards" />
      <a class="underline hover:text-primary" href={withBase("/about")}
        >About JOSH</a
      >
      <a
        class="underline hover:text-primary"
        href={`mailto:${siteConfig.contactEmail}`}>Add your hardware</a
      >
    </div>
  </header>
  <section
    class="px-6 lg:px-20 xl:px-32 py-6 md:py-10 w-full max-w-6xl lg:max-w-none 2xl:w-11/12 md:grid grid-cols-3 3xl:grid-cols-4 4xl:grid-cols-5 gap-4"
  >
    <div class="col-start-1 col-span-1">
      <SearchInput client:load />
      <FilterMenu uniqueTags={uniqueTags} client:only="react" />
      <!-- small screens: filter button + sort select share a row; md+: unwrapped -->
      <div class="flex items-center gap-4 md:contents">
        <ToggleFilterMenuBtn client:only="react" />
        <SortMenu client:only="react" />
      </div>
    </div>
    <div class="col-start-2 col-span-2 3xl:col-span-3 4xl:col-span-4">
      <ProjectCount
        allContent={allProjects}
        contentType="projects"
        client:only="react"
      />
      <div
        class="grid grid-cols-1 lg:grid-cols-2 3xl:grid-cols-3 4xl:grid-cols-4 auto-rows-max gap-4"
      >
        {
          allProjects.map((content) => {
            const tagsObj = getTagKeysAndValues(content);
            const sortOrder = {
              alphabetical: sortedIdsMap.alphabetical.indexOf(content.id),
              "updated-newest": sortedIdsMap["updated-newest"].indexOf(content.id),
              "updated-oldest": sortedIdsMap["updated-oldest"].indexOf(content.id),
            };
            return (
              <CardContainer
                key={content.id}
                url={withBase(`/projects/${content.id}/`)}
                title={content.data.title}
                tagsObj={tagsObj}
                contentType="projects"
                maxLength={allProjects.length}
                sortOrder={sortOrder}
                client:only="react"
              >
                {content.data["image file"] ? (
                  <img
                    src={withBase(`/project-images/${content.data["image file"]}`)}
                    class="w-full h-40 object-cover object-center bg-white"
                    loading="lazy"
                    slot="cardImage"
                  />
                ) : (
                  <CardImage slot="cardImage" client:only="react" />
                )}

                <CardContent
                  title={content.data.title}
                  tagline={content.data.tagline}
                  tagsObj={tagsObj}
                  slot="cardContent"
                />
                <Fragment slot="tags">
                  {Object.entries(tagsObj).map(([tagCat, tags]) => {
                    return tags.map((tag) => {
                      return (
                        <Tag tagCat={tagCat} tag={tag} contentType="projects" />
                      );
                    });
                  })}
                </Fragment>
              </CardContainer>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
