---
import { getBackgroundColor } from "@utils/getTagBgColor";
import { updateSearchParamUrl } from "@utils/updateTagUrlParams";
import { withBase } from "@utils/withBase";

const { tagCat, tag, contentType } = Astro.props;

const contentUrl = new URL(withBase(`/${contentType}`), Astro.url.origin);
// Relative link, so it works on any domain or base path
const fullUrl = new URL(updateSearchParamUrl(contentUrl.href, tag));
const updatedUrl = `${fullUrl.pathname}${fullUrl.search}`;

const backgroundColor = getBackgroundColor(tagCat);
const style = { backgroundColor: backgroundColor };
---

<a
  class="relative pointer-events-auto bg-primary text-white px-1.5 py-1 rounded-md text-xs hover:opacity-70 transition duration-300 transform"
  style={style}
  href={updatedUrl}
>
  {tag}
</a>
