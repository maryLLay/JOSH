---
import { withBase } from "@utils/withBase";

// Switches between the card view (/projects) and the table view (/projects-table)
const { current } = Astro.props;

const views = [
  { key: "cards", text: "Card view", href: "/projects" },
  { key: "table", text: "Table view", href: "/projects-table" },
];
---

<div
  class="inline-flex rounded-md border border-slate-300 dark:border-slate-700 overflow-hidden text-sm"
  role="group"
  aria-label="Choose how to view projects"
>
  {
    views.map(({ key, text, href }) => (
      <a
        href={withBase(href)}
        aria-current={current === key ? "page" : undefined}
        class:list={[
          "px-3 py-1.5 transition-colors",
          current === key
            ? "bg-primary text-white font-semibold"
            : "hover:bg-slate-100 dark:hover:bg-slate-800",
        ]}
      >
        {text}
      </a>
    ))
  }
</div>
