---
import Citation from "./Citation.astro";
import { Icon } from "astro-icon/components";
import { getRepoHost, getHostLabel } from "@utils/fetchRepoInfo";
const { frontmatter, repoInfo } = Astro.props;

const repositoryLink = frontmatter["repository link"];
const hostLabel = getHostLabel(repositoryLink);

// Where the project files live, if that differs from the repository link
// (e.g. a Figshare record whose file entry points at a GitHub repo)
const projectFilesLink =
  repoInfo?.projectFilesUrl && repoInfo.projectFilesUrl !== repositoryLink
    ? repoInfo.projectFilesUrl
    : null;

// Issues only exist on GitHub, so only offer this link for GitHub repositories
const githubRepoLink = [repositoryLink, projectFilesLink].find(
  (link) => getRepoHost(link) === "github"
);
let githubIssueLink = "";
try {
  githubIssueLink = githubRepoLink
    ? new URL(`${githubRepoLink.replace(/\/$/, "")}/issues`).href
    : "";
} catch {
  githubIssueLink = "";
}
---

<div class="p-6 rounded-md shadow-sm lg:shadow-none bg-page">
  <h2 class="text-xl font-bold mb-6">Quick links</h2>
  <div class="flex flex-row flex-wrap gap-6 mx-auto">
    <div class="flex flex-col gap-1 mr-8">
      <h3 class="font-bold mb-1">Get started</h3>
      {
        repositoryLink ? (
          <a
            class="self-start flex items-center gap-1 transition ease-in duration-200 hover:text-primary dark:text-slate-300 dark:hover:text-accent cursor-pointer"
            href={repositoryLink}
          >
            <Icon
              name="tabler:square-chevron-right"
              class="w-5 h-5  inline-block"
            />
            {`View on ${hostLabel}`}
          </a>
        ) : null
      }

      {
        projectFilesLink ? (
          <a
            class="self-start flex items-center gap-1 transition ease-in duration-200 hover:text-primary dark:text-slate-300 dark:hover:text-accent cursor-pointer"
            href={projectFilesLink}
          >
            <Icon
              name="tabler:square-chevron-right"
              class="w-5 h-5  inline-block"
            />
            {`Project files on ${getHostLabel(projectFilesLink)}`}
          </a>
        ) : null
      }

      {
        frontmatter["documentation link"] ? (
          <a
            class="self-start flex items-center gap-1 transition ease-in duration-200 hover:text-primary dark:text-slate-300 dark:hover:text-accent cursor-pointer"
            href={frontmatter["documentation link"]}
          >
            <Icon
              name="tabler:square-chevron-right"
              class="w-5 h-5  inline-block"
            />
            Documentation
          </a>
        ) : null
      }
    </div>
    <div class="flex flex-col gap-1 mr-8 md:mr-12">
      <h3 class="font-bold mb-1">Get help</h3>
      {
        githubIssueLink ? (
          <a
            class="self-start btn rounded-md p-2 font-normal"
            href={githubIssueLink}
          >
            Open an issue on GitHub
          </a>
        ) : null
      }
      {
        frontmatter["preferred contact method"] ? (
          <a
            class="self-start btn rounded-md p-2 font-normal"
            href={frontmatter["preferred contact method"]}
          >
            Reach out with a question
          </a>
        ) : null
      }
    </div>
    <div class="flex flex-col gap-1">
      <h3 class="font-bold mb-1">Cite this project</h3>
      <Citation
        citationText={frontmatter["how to cite text"]
          ? frontmatter["how to cite text"]
          : null}
        citationLink={frontmatter["how to cite link"]
          ? frontmatter["how to cite link"]
          : null}
        repoInfo={repoInfo}
        repositoryLink={repositoryLink}
        hostLabel={hostLabel}
      />
    </div>
  </div>
</div>
