---
import Link from "@components/Link.astro";

const { team } = Astro.props;
---

{
  team && team.length ? (
    <div class="flex items-center flex-wrap mb-2 gap-3">
      <p class="font-semibold">Development Team:</p>
      {team.map(({ name, url }) =>
        url ? <Link url={url} text={name} /> : <span>{name}</span>
      )}
    </div>
  ) : null
}
