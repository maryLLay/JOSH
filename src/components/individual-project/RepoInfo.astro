---
import Link from "@components/Link.astro";
const { repoInfo, hideLicense = false } = Astro.props;
// hideLicense: the project file sets its own license tag, which takes priority
// (a Figshare record can only use a standard license, e.g. CC BY 4.0).

const formatDate = (iso) =>
  iso
    ? new Date(iso).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      })
    : null;
---

{
  repoInfo && repoInfo.host === "figshare" ? (
    <div class="mb-2 flex flex-col gap-1">
      {repoInfo.authors.length ? (
        <div class="flex flex-wrap gap-x-3">
          <p class="font-semibold">Authors:</p>
          {repoInfo.authors.map((author) =>
            author.orcid ? (
              <Link
                url={`https://orcid.org/${author.orcid}`}
                text={author.name}
              />
            ) : (
              <span>{author.name}</span>
            )
          )}
        </div>
      ) : null}
      {repoInfo.doi ? (
        <div class="flex flex-wrap gap-x-3">
          <p class="font-semibold">DOI:</p>
          <Link
            url={`https://doi.org/${repoInfo.doi}`}
            text={repoInfo.doi}
          />
        </div>
      ) : null}
      {repoInfo.license && !hideLicense ? (
        <div class="flex flex-wrap gap-x-3">
          <p class="font-semibold">Figshare record license:</p>
          {repoInfo.license.url ? (
            <Link url={repoInfo.license.url} text={repoInfo.license.name} />
          ) : (
            <span>{repoInfo.license.name}</span>
          )}
        </div>
      ) : null}
      {repoInfo.publishedDate ? (
        <div class="flex flex-wrap gap-x-3">
          <p class="font-semibold">Published:</p>
          <span>
            {formatDate(repoInfo.publishedDate)}
            {repoInfo.version ? ` (version ${repoInfo.version})` : ""}
          </span>
        </div>
      ) : null}
    </div>
  ) : null
}
