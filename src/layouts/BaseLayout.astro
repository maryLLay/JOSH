---
import "@styles/tailwind.css";
import { siteConfig } from "../siteConfig";
import CustomStyles from "@styles/CustomStyles.astro";

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { withBase } from "@utils/withBase";

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico")} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      property="og:title"
      content="Janelia Open Source Hardware"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta
      property="og:description"
      content="A catalogue of open source hardware projects developed by teams at Janelia Research Campus."
    />
    <title>{siteConfig.shortName}</title>
    <CustomStyles />
  </head>
  <body class="text-default bg-page min-h-screen flex flex-col">
    <Header />
    <slot />
    <Footer />
    <script>
      import "../scripts/navbarFunctions.js";
    </script>
  </body>
</html>
